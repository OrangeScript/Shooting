
/* HUD 全屏容器 */
#HUDRoot {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    overflow: visible;
}

/* 生命值数字 */
#HealthText {
    position: absolute;

    bottom: 70px;
    left: 0;

    width: 240px;
    height: 28px;

    font-size: 20px;
    color: white;

    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* 深色血条背景 */
#HealthBarBG {
    position: absolute;

    bottom: 38px;
    left: 0;

    width: 120px;
    height: 22px;

    flex-grow: 0;
    flex-shrink: 0;

    background-color: rgb(50, 55, 65);

    border-radius: 5px;
    overflow: hidden;
}

/* 上一层底色、当前层和两段跨层回血共用固定容器 */
#LayerBaseFill,
#HealthFill,
#GrowthFill,
#GrowthWrapFill {
    position: absolute;

    left: 0;
    top: 0;

    width: 0px;
    height: 100%;

    flex-grow: 0;
    flex-shrink: 0;
}

/* 实际血量的RGB由脚本按层数逐渐调深 */
#LayerBaseFill,
#HealthFill {
    background-color: rgb(255, 85, 100);
}

/* 回血先以绿色显示，再由当前层颜色覆盖 */
#GrowthFill,
#GrowthWrapFill {
    background-color: rgb(85, 235, 115);
}


/* 精英怪头顶生命值 */
.enemy-hp-number {
    position: absolute;

    width: 88px;
    height: 30px;

    font-size: 20px;
    color: rgb(255, 225, 140);

    -unity-text-align: middle-center;
    -unity-font-style: bold;

    background-color: rgba(20, 22, 30, 0.72);
    border-radius: 7px;

    flex-grow: 0;
    flex-shrink: 0;
}

.run-text,
.run-text .unity-label,
.run-text .unity-button {
    -unity-font: url("../../UI/ZH-CN.TTF");
    -unity-font-definition: initial;
}

.run-text {
    color: rgb(238, 246, 241);
}

.run-hud {
    position: absolute;
    top: 18px;
    left: 16px;
    right: 16px;
    align-items: center;
}

.run-status {
    margin: 0;
    padding: 8px 20px;
    max-width: 100%;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(13, 26, 30, 0.88);
    border-width: 1px;
    border-color: rgb(74, 116, 105);
    border-radius: 9px;
}

.run-boss {
    width: 84%;
    max-width: 520px;
    margin-top: 8px;
    padding: 8px 12px 12px 12px;
    background-color: rgba(25, 19, 27, 0.92);
    border-width: 1px;
    border-color: rgb(155, 70, 77);
    border-radius: 8px;
}

.run-boss-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.run-boss-label,
.run-boss-value {
    margin: 0;
    font-size: 18px;
    color: rgb(255, 212, 202);
}

.run-boss-track {
    height: 8px;
    margin-top: 5px;
    overflow: hidden;
    border-radius: 4px;
    background-color: rgb(63, 42, 55);
}

.run-boss-fill {
    height: 100%;
    background-color: rgb(244, 114, 111);
}

.run-result {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(7, 13, 16, 0.8);
    padding: 16px;
}

.run-result-card {
    align-items: stretch;
    width: 100%;
    max-width: 560px;
    flex-shrink: 0;
    padding: 24px;
    background-color: rgb(16, 32, 36);
    border-width: 1px;
    border-color: rgb(90, 113, 110);
    border-top-width: 4px;
    border-top-color: rgb(241, 133, 115);
    border-radius: 12px;
}

.run-result-card.victory {
    border-top-color: rgb(128, 218, 170);
}

.run-result-title {
    margin: 0;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.run-result-details {
    margin: 8px 0 16px 0;
    color: rgb(180, 207, 200);
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.run-result-button {
    min-height: 68px;
    margin: 4px 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(238, 246, 241);
    background-color: rgb(39, 66, 68);
    border-width: 1px;
    border-color: rgb(93, 133, 121);
    border-radius: 8px;
}

.run-result-button-primary {
    color: rgb(14, 41, 32);
    background-color: rgb(153, 224, 184);
    border-color: rgb(199, 247, 213);
}

.run-result-button:hover,
.run-result-button:focus {
    color: rgb(14, 41, 32);
    background-color: rgb(192, 240, 209);
    border-color: rgb(223, 252, 232);
}

.run-result-button:active {
    color: rgb(14, 41, 32);
    background-color: rgb(123, 203, 159);
}

.run-hidden {
    display: none;
}
