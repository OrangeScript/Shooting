<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu_1/MainMenu.uss?fileID=7433441132597879392&amp;guid=87e4e9235bbba3945833ba92bd1a8e42&amp;type=3#MainMenu" />
    <ui:VisualElement class="menu-root">
        <ui:VisualElement class="brand">
            <ui:Label text="SHOOTING" class="brand-title" />
            <ui:Label text="SURVIVE THE WAVES" class="brand-subtitle" />
        </ui:VisualElement>
        <ui:VisualElement class="bottom-menu">
            <ui:VisualElement name="HomePage" class="menu-page">
                <ui:Button name="SoloButton" text="单人游戏" class="menu-button" style="-unity-font: url(&quot;project://database/Assets/UI/ZH-CN.TTF?fileID=12800000&amp;guid=a8486fd5da0b84346be64972d8c3c492&amp;type=3#ZH-CN&quot;); -unity-font-definition: initial;" />
                <ui:Button name="MultiButton" text="多人游戏" class="menu-button" />
                <ui:Button name="CodexButton" text="道具图谱" class="menu-button" />
                <ui:Button name="OptionsButton" text="选项" class="menu-button" />
                <ui:Button name="QuitButton" text="退出游戏" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="MultiplayerPage" class="menu-page" style="display: none;">

                <ui:Label text="多人游戏" class="page-title" />

                <ui:Button
                    name="CreateButton"
                    text="创建游戏"
                    class="menu-button" />

                <ui:Button
                    name="JoinButton"
                    text="加入游戏"
                    class="menu-button" />

                <!-- 房主 IP 输入框 -->
                <ui:TextField
                    name="RoomAddress"
                    label="房主 IP"
                    value="127.0.0.1"
                    class="room-address" />

                <!-- 开始合作按钮 -->
                <ui:Button
                    name="RoomStartButton"
                    text="开始合作"
                    class="menu-button" />

                <!-- 房间状态 -->
                <ui:Label
                    name="RoomStatus"
                    text="请输入房主地址"
                    class="page-hint" />

                <ui:Button
                    name="MultiBackButton"
                    text="← 返回"
                    class="menu-button" />

            </ui:VisualElement>
            <ui:VisualElement name="InfoPage" class="menu-page" style="display: none;">
                <ui:Label name="InfoTitle" class="page-title" />
                <ui:Label text="功能尚未接入" class="page-hint" />
                <ui:Button name="InfoBackButton" text="← 返回" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
